# Supabase — copy to .env.local and fill in. NEVER commit real keys.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Used by adapters / seed scripts. Never exposed to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# NWS requires a User-Agent with a contact email (api.weather.gov policy).
NWS_CONTACT_EMAIL=ops@example.com

# Optional Socrata app token (higher rate limits for CPD / Dallas open data).
SOCRATA_APP_TOKEN=

# Protects the Vercel cron endpoints. When set, cron requests must send
# Authorization: Bearer <CRON_SECRET>. Vercel injects this automatically.
CRON_SECRET=

# Licensed news (NewsAPI.org Business or Perigon-class). Adapter is dark
# until this is set. Commercial-use license required (Watch republishes).
NEWSAPI_KEY=

# Citizen Enterprise webhook shared secret. The /api/webhooks/citizen slot
# returns 503 (not contracted) until this is set. Trial keys land at the
# Aug 6 meeting; flip this on to light up the verified-incident stream.
CITIZEN_WEBHOOK_SECRET=
